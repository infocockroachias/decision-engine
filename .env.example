# =============================================
# Decision Engine — Environment Configuration
# Copy this file to `.env` or `.env.local` and fill in values.
# Never commit real secrets to version control.
# =============================================

# ---------- Database (PostgreSQL via Prisma) ----------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For Vercel Postgres: auto-provisioned via Vercel dashboard → Storage → Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/decision_engine"

# Prisma shadow database (required for migrations on VercEL/CI)
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/decision_engine_shadow"

# ---------- LongCat API ----------
# Your LongCat API key (obtained from https://longcat.chat or your account dashboard)
LONGCAT_API_KEY="your-longcat-api-key-here"

# Base URL for LongCat API (change if using self-hosted / alternate region)
LONGCAT_BASE_URL="https://api.longcat.chat"

# LongCat model to use (e.g., longcat-flash, longcat-pro)
LONGCAT_MODEL="longcat-flash"

# ---------- Application ----------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Decision Engine"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# NextAuth secret (generate: openssl rand -base64 32)
NEXTAUTH_SECRET="generate-a-random-secret-here"

# ---------- Analytics / Monitoring (optional) ----------
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"